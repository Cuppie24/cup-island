// Windows resources for CupIsland.exe. Icon 1 is the exe's icon (Explorer,
// taskbar, installer) and the tray icon (platform/tray_icon.cpp).
// The .ico must hold every size Windows asks for (16-256 px), each scaled
// ahead of time: given only one, Windows resizes it with a cheap filter.
1 ICON "cup_island.ico"

// The version on the exe's Details tab and in Task Manager (decision 036).
// cup_version.h is generated by CMake into the build folder.
#include "cup_version.h"

1 VERSIONINFO
FILEVERSION CUP_VERSION_NUMBERS
PRODUCTVERSION CUP_VERSION_NUMBERS
FILEOS 0x40004   // VOS_NT_WINDOWS32
FILETYPE 0x1     // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // US English, Unicode
        BEGIN
            VALUE "CompanyName", "Cup Island"
            VALUE "FileDescription", "Cup Island"
            VALUE "FileVersion", CUP_VERSION_STRING
            VALUE "InternalName", "CupIsland"
            VALUE "OriginalFilename", "CupIsland.exe"
            VALUE "ProductName", "Cup Island"
            VALUE "ProductVersion", CUP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
