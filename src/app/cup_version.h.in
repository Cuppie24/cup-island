/* The version this build is (decision 036). Generated by CMake from
   src/app/cup_version.h.in into the build folder: never edit the copy.
   Plain #defines, because the resource compiler reads it too (the exe's
   Details tab, assets/cup_island.rc). */
#ifndef CUP_VERSION_H
#define CUP_VERSION_H

/* "0.4.0" for a release; "0.3.0-5-gabc1234" or "0.0.0-dev" for a dev build. */
#define CUP_VERSION_STRING "@CUP_APP_VERSION@"
/* Its numbers, for Windows' version resource (always four). */
#define CUP_VERSION_NUMBERS @CUP_VERSION_MAJOR@,@CUP_VERSION_MINOR@,@CUP_VERSION_PATCH@,0

#endif
